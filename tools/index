#!/usr/bin/env python3
"""tools/index --universe DIR [--entries DIR] [--out FILE] [--allow-local]: checks every extensions/<id>.toml against
its archive and writes the index Universe reads (docs/extensions.md, The index). Any failing entry fails the run."""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import re
import sys
import tarfile
import tomllib
import urllib.error
import urllib.request
import zipfile
from pathlib import Path, PurePosixPath

SCHEMA = 1
KINDS = ("module", "source")
FIELDS = ("id", "kind", "name", "description", "author", "license", "homepage", "url", "sha256")
# Universe's own rule for an extension id (crates/universe/src/extensions.rs, valid_id).
ID = re.compile(r"^[a-z0-9][a-z0-9_-]*$")
SHA256 = re.compile(r"^[0-9a-fA-F]{64}$")


class Bad(Exception):
    pass


def shipped_ids(universe: Path) -> dict[str, str]:
    """Every id a Universe checkout ships, module or source, with its kind."""
    ids = {}
    for kind in KINDS:
        root = universe / f"{kind}s"
        if not root.is_dir():
            raise SystemExit(f"{universe}: no {kind}s folder, not a Universe checkout")
        for manifest in sorted(root.glob(f"*/{kind}.toml")):
            ids[tomllib.loads(manifest.read_text())["id"]] = kind
    return ids


def fetch(url: str) -> bytes:
    request = urllib.request.Request(url, headers={"User-Agent": "universe-extensions"})
    try:
        with urllib.request.urlopen(request, timeout=120) as r:
            return r.read()
    except (urllib.error.URLError, OSError) as e:
        raise Bad(f"{url} could not be downloaded: {e}") from e


def members(body: bytes) -> dict[tuple[str, ...], bytes | None]:
    """The archive's paths as parts, with a regular file's bytes; None for a folder or anything else."""
    if body[:4] == b"PK\x03\x04":
        with zipfile.ZipFile(io.BytesIO(body)) as z:
            return {PurePosixPath(i.filename).parts: None if i.is_dir() else z.read(i) for i in z.infolist()}
    modes = {b"\x1f\x8b": "r:gz", b"\xfd7zXZ\x00": "r:xz"}
    mode = next((m for magic, m in modes.items() if body.startswith(magic)), "r:" if body[257:262] == b"ustar" else "")
    if not mode:
        raise Bad("the archive is not a tar (plain, gzip or xz) or a zip")
    with tarfile.open(fileobj=io.BytesIO(body), mode=mode) as t:
        found = {}
        for m in t.getmembers():
            parts = tuple(p for p in PurePosixPath(m.name).parts if p != ".")
            if parts:
                found[parts] = t.extractfile(m).read() if m.isfile() else None
        return found


def manifest(body: bytes) -> tuple[str, dict]:
    """The kind and the manifest of the extension the archive holds, at its root or in its one folder."""
    files = members(body)

    def kinds(root: tuple[str, ...]) -> list[str]:
        return [k for k in KINDS if files.get((*root, f"{k}.toml")) is not None]

    top = {parts[0] for parts in files}
    root = (*top,) if not kinds(()) and len(top) == 1 and any(len(p) > 1 for p in files) else ()
    match kinds(root):
        case [kind]:
            try:
                return kind, tomllib.loads(files[(*root, f"{kind}.toml")].decode())
            except (UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
                raise Bad(f"its {kind}.toml does not parse: {e}") from e
        case []:
            raise Bad("the archive holds no module.toml or source.toml, at its root or in its one folder")
        case _:
            raise Bad("the archive holds both a module.toml and a source.toml")


def check(path: Path, shipped: dict[str, str], allow_local: bool) -> dict:
    try:
        entry = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as e:
        raise Bad(f"not TOML: {e}") from e
    problems = [f"{f} is missing or empty" for f in FIELDS if not isinstance(entry.get(f), str) or not entry[f].strip()]
    problems += [f"{f} is not a field of an entry" for f in sorted(set(entry) - set(FIELDS))]
    if problems:
        raise Bad("; ".join(problems))
    schemes = ("https://", "file://") if allow_local else ("https://",)
    if not ID.match(entry["id"]):
        problems.append(f"id {entry['id']!r} is not lowercase letters, digits, - and _")
    if entry["id"] != path.stem:
        problems.append(f"id {entry['id']} differs from the file's name, {path.name}")
    if entry["kind"] not in KINDS:
        problems.append(f"kind {entry['kind']!r} is not module or source")
    if not entry["url"].startswith(schemes):
        problems.append(f"url {entry['url']} is not https://")
    if not entry["homepage"].startswith("https://"):
        problems.append(f"homepage {entry['homepage']} is not https://")
    if not SHA256.match(entry["sha256"]):
        problems.append("sha256 is not 64 hex digits")
    if entry["id"] in shipped:
        problems.append(f"{entry['id']} ships with Universe as a {shipped[entry['id']]}")
    if problems:
        raise Bad("; ".join(problems))
    body = fetch(entry["url"])
    sha256 = hashlib.sha256(body).hexdigest()
    if sha256 != entry["sha256"].lower():
        raise Bad(f"{entry['url']} has sha256 {sha256}, not the entry's {entry['sha256']}")
    kind, held = manifest(body)
    if kind != entry["kind"]:
        problems.append(f"the entry is a {entry['kind']}, the archive holds a {kind}")
    if held.get("id") != entry["id"]:
        problems.append(f"the archive's {kind}.toml has id {held.get('id')!r}, not {entry['id']}")
    version, api = held.get("version"), held.get("api")
    if not isinstance(version, str) or not version.strip():
        problems.append(f"the archive's {kind}.toml has no version")
    if type(api) is not int or api < 1:
        problems.append(f"the archive's {kind}.toml has no api number")
    if kind == "source" and not (isinstance(held.get("exe"), str) and held["exe"].strip()):
        problems.append("the archive's source.toml names no exe")
    if problems:
        raise Bad("; ".join(problems))
    return {
        "id": entry["id"],
        "kind": kind,
        "name": entry["name"],
        "version": version,
        "description": entry["description"],
        "api": api,
        "url": entry["url"],
        "sha256": sha256,
        "size": len(body),
        "homepage": entry["homepage"],
    }


def main() -> None:
    parser = argparse.ArgumentParser(description=(__doc__ or "").split("\n", 1)[0])
    parser.add_argument("--universe", type=Path, required=True, help="a Universe checkout: the ids its modules/ and sources/ ship are refused")
    parser.add_argument("--entries", type=Path, default=Path("extensions"), help="the folder of <id>.toml entries")
    parser.add_argument("--out", default="-", help="where to write index.json; - for stdout")
    parser.add_argument("--allow-local", action="store_true", help="also take file:// archive URLs, for the tests")
    args = parser.parse_args()
    shipped = shipped_ids(args.universe)
    listed, failed = [], []
    for path in sorted(args.entries.glob("*.toml")):
        print(path.name, file=sys.stderr)
        try:
            listed.append(check(path, shipped, args.allow_local))
        except Bad as e:
            print(f"  {path.name}: {e}", file=sys.stderr)
            failed.append(path.name)
    if failed:
        raise SystemExit(f"failed: {', '.join(failed)}")
    text = json.dumps({"schema": SCHEMA, "extensions": listed}, indent=1) + "\n"
    if args.out == "-":
        sys.stdout.write(text)
    else:
        Path(args.out).write_text(text)


if __name__ == "__main__":
    main()
